{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restricted numerical-analysis input contract",
  "description": "Operational file and field contract. Inputs remain in the authorized workspace; not distributed.",
  "type": "object",
  "required": [
    "validation_inputs.csv",
    "sampling_design_inputs.csv",
    "mimic_patient_cluster_counts.csv",
    "aggregate_context_inputs.json"
  ],
  "properties": {
    "validation_inputs.csv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stratum",
          "final_label",
          "weight",
          "P0",
          "P1",
          "enzyme_ge3",
          "has_enzyme",
          "pain_pos",
          "pain_neg",
          "image_pos",
          "image_neg"
        ],
        "properties": {
          "stratum": {},
          "final_label": {},
          "weight": {},
          "P0": {},
          "P1": {},
          "enzyme_ge3": {},
          "has_enzyme": {},
          "pain_pos": {},
          "pain_neg": {},
          "image_pos": {},
          "image_neg": {}
        }
      }
    },
    "sampling_design_inputs.csv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stratum",
          "patient_pool_N",
          "formal_sample_n",
          "development_n",
          "validation_n"
        ],
        "properties": {
          "stratum": {},
          "patient_pool_N": {},
          "formal_sample_n": {},
          "development_n": {},
          "validation_n": {}
        }
      }
    },
    "mimic_patient_cluster_counts.csv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_token",
          "n_P0",
          "d_P0",
          "n_P1",
          "d_P1",
          "n_P2",
          "d_P2",
          "n_P3",
          "d_P3"
        ],
        "properties": {
          "cluster_token": {},
          "n_P0": {},
          "d_P0": {},
          "n_P1": {},
          "d_P1": {},
          "n_P2": {},
          "d_P2": {},
          "n_P3": {},
          "d_P3": {}
        }
      }
    },
    "aggregate_context_inputs.json": {
      "type": "object",
      "required": [
        "transport",
        "downstream_prior"
      ]
    }
  }
}
