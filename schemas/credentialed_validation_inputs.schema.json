{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restricted validation input contract",
  "description": "Column contract only. No patient-level input is included in this repository.",
  "type": "object",
  "required": ["reference_set", "patient_predictions", "patient_split", "sampling_frame"],
  "properties": {
    "reference_set": {"type": "array", "items": {"type": "string"}, "const": ["case_key", "reference_label", "reference_version"]},
    "patient_predictions": {"type": "array", "items": {"type": "string"}, "const": ["case_key", "P0", "P1", "P2", "P3", "P5"]},
    "patient_split": {"type": "array", "items": {"type": "string"}, "const": ["case_key", "patient_key", "split"]},
    "sampling_frame": {"type": "array", "items": {"type": "string"}, "const": ["case_key", "stratum", "pool_n", "sampled_n"]}
  }
}
